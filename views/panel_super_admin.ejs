            <!-- Modal - Crear Rifa-->
            <div id="formularioMultiplesPasosModal" class="formModal hidden">
                <div class="modal-formularioMultiplesPasos-content">
                    <span id="closeModalBtn" class="close-btn">&times;</span>
                    <!-- Formulario multipaso -->
                    <div class="container_indicador_pasos">
                        <div class="step-progress">
                            <div class="step active" data-title="Rifa Info">
                                <div class="circle">✓</div>
                            </div>
                            <div class="step" data-title="Precio Boletos">
                                <div class="circle">✓</div>
                            </div>
                            <div class="step" data-title="PreSorteo">
                                <div class="circle">✓</div>
                            </div>
                            <div class="step" data-title="Cantidad Lugares">
                                <div class="circle">✓</div>
                            </div>
                            <div class="step" data-title="Premio Lugares">
                                <div class="circle">✓</div>
                            </div>
                            <div class="step" data-title="Bonos">
                                <div class="circle">✓</div>
                            </div>
                            <div class="step" data-title="Detalles Bonos">
                                <div class="circle">✓</div>
                            </div>
                            <div class="step" data-title="Mensajes">
                                <div class="circle">✓</div>
                            </div>
                            <div class="step" data-title="Detalles Mensajes">
                                <div class="circle">✓</div>
                            </div>
                            <div class="step" data-title="">
                                <!--
                                <div class="circle">✓</div>
                                -->
                            </div>
                            <div class="step" data-title="Success">
                                <div class="circle">✓</div>
                            </div>
                        </div>
                        
                        <form id="multiStepForm" enctype="multipart/form-data">
                            <div class="form-step active">
                                <h2>Informacion de la Rifa</h2>
                                <div class="input-group">
                                    <label for="edicion">TITULO:</label>
                                    <input type="text" class="input_form_pasos_modal" id="titulo" name="titulo" placeholder="TITULO">
                                </div>
                                <div class="input-inline-group">
                                    <div class="input-group">
                                        <label for="edicion">EDICIÓN:</label>
                                        <input type="number" class="input_form_pasos_modal" name="edicion" id="edicion"
                                            value="<%= ultima_emision %>" min="1" placeholder="EDICION" readonly>
                                    </div>
                                    <div class="input-group">
                                        <label for="emisiones">EMISIONES:</label>
                                        <input type="text" class="input_form_pasos_modal" name="emisiones" id="emisiones" pattern="\d{6}"
                                            min="1" maxlength="6" inputmode="numeric" placeholder="EMISIONES"
                                            title="Por favor, ingresa solo números">
                                    </div>
                                    <div class="input-group">
                                        <label for="oportunidades">OPORTUNIDADES:</label>
                                        <input type="text" class="input_form_pasos_modal" name="oportunidades" id="oportunidades"
                                            pattern="\d{6}" min="1" maxlength="6" inputmode="numeric" placeholder="OPORTUNIDADES"
                                            title="Por favor, ingresa solo números">
                                    </div>
                                    <div class="input-group">
                                        <label for="cantidad_boletos">CANTIDAD DE BOLETOS:</label>
                                        <input type="text" class="input_form_pasos_modal" name="cantidad_boletos" id="cantidad_boletos"
                                            pattern="\d{6}" min="1" maxlength="6" inputmode="numeric" placeholder="CANTIDAD DE BOLETOS"
                                            title="Por favor, ingresa solo números" readonly>
                                    </div>
                                    <div class="input-group">
                                        <label for="fecha">FECHA:</label>
                                        <input type="date" class="input_form_pasos_modal" name="fecha" id="fecha" placeholder="FECHA">
                                    </div>
                                    <div class="input-group">
                                        <label for="rifa_activa">ACTIVA:</label>
                                        <select name="rifa_activa" id="rifa_activa" class="input_form_pasos_modal">
                                            <option value="1">SI</option>
                                            <option value="0">NO</option>
                                        </select>
                                    </div>
                                    <div class="input-group">
                                        <label for="imagenes">SUBIR IMAGEN (HASTA 10):</label>
                                        <input type="file" id="imagenes" name="imagenes" class="input_form_pasos_modal" accept="image/*" multiple required><br>
                                    </div>
