        <style>
            /* Poner en la misma linea los inputs *
            .input-inline-group {
                display: flex;
                gap: 10px; /* espacio entre inputs *
            }
            .input-inline-group input {
                flex: 1;
                min-width: 0; /* Importante para evitar desbordamiento *
            }
            */
            .input-inline-group {
                display: flex;
                gap: 10px;
                flex-wrap: wrap;
                width: 100%;
            }
            .input-inline-group input {
                flex: 1 1 30%; /* ~3 por fila contando el gap */
                min-width: 0;
            }

            .input-group {
                flex: 1 1 30%;
                min-width: 0;
                display: flex;
                flex-direction: column;
            }

            .input-group label {
                font-size: 13px;
                color: #ffffff;
                font-weight: bold;
            }

            /* Pantallas medianas: 2 por fila */
            @media (max-width: 768px) {
                .input-inline-group input {
                    flex: 1 1 45%;
                }
                .input-group {
                    flex: 1 1 45%;
                }
            }
            /* Pantallas pequeñas: 1 por fila */
            @media (max-width: 480px) {
                .input-inline-group input {
                    flex: 1 1 100%;
                }
                .input-group {
                    flex: 1 1 100%;
                }
            }
            

            .select-group {
                display: flex;
                align-items: center;
                gap: 5px;
            }
            .select-group label {
                white-space: nowrap;
                font-size: 14px; /* opcional */
            }


            .input_form_pasos_modal[readonly] {
                background-color: #111111;
                cursor: not-allowed;
                color: #666;
            }


            .input_tipoBono{
                width: 50% !important;
            }


            .label_class_form_crearRifa{
                white-space: normal !important;
                word-wrap: break-word; /* o también: word-break: break-word; */
            }


            .div_bonos_class{
                margin-top: 30px;
            }
        </style>
    </head>
