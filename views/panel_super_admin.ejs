            <div id="formularioMultiplesPasosModal" class="formModal hidden">
                <div class="modal-formularioMultiplesPasos-content">
                    <span id="closeModalBtn" class="close-btn">&times;</span>
                    <!-- Formulario multipaso -->
                    <div class="container_indicador_pasos">
                        <div class="step-progress">
                            <div class="step active" data-title="Plantilla Pagina">
                                <div class="circle">✓</div>
                            </div>
                            <div class="step" data-title="Rifa Info">
                                <div class="circle">✓</div>
                            </div>
                            <div class="step" data-title="Success">
                                <div class="circle">✓</div>
                            </div>
                        </div>
            
                        <form id="multiStepForm">
                            <div class="form-step active">
                                <h2>Plantilla Pagina Boletos</h2>
                                <iframe id="vista_previa" src="http://localhost:3000/lista-boletos-plantilla-editable-iframe" style="width:100%; height:600px;"></iframe>
                                <div class="buttons only-next">
                                    <button type="button" class="button_form_pasos_modal next">Next</button>
                                </div>
                            </div>
                            <div class="form-step">
                                <h2>Informacion de la Rifa</h2>
                                <input type="number" class="input_form_pasos_modal" id="edicion" min="1" placeholder="NUMERO DE EDICION">
                                <input type="text" class="input_form_pasos_modal" id="emisiones" pattern="\d{6}" maxlength="6" inputmode="numeric" placeholder="NÚMERO DE EMISIONES" title="Por favor, ingresa solo números">
                                <input type="text" class="input_form_pasos_modal" id="oportunidades" pattern="\d{6}" maxlength="6" inputmode="numeric" placeholder="NÚMERO DE OPORTUNIDADES" title="Por favor, ingresa solo números">
                                <input type="text" class="input_form_pasos_modal" id="cantidad_boletos" pattern="\d{6}" maxlength="6" inputmode="numeric" placeholder="CANTIDAD DE BOLETOS" title="Por favor, ingresa solo números">
                                <input type="date" class="input_form_pasos_modal" id="fecha" placeholder="FECHA">
                                <input type="text" class="input_form_pasos_modal" id="premio" placeholder="PREMIO">
                                ACTIVO: <select name="rifa_activa" id="rifa_activa" class="input_form_pasos_modal">
                                    <option value="1">SI</option>
                                    <option value="0">NO</option>
                                </select>
                                <div class="buttons">
                                    <button type="button" class="button_form_pasos_modal prev">Back</button>
                                    <button type="button" class="button_form_pasos_modal next">Next</button>
                                </div>
                            </div>
                            <div class="form-step">
                                <h2>Success 🎉</h2>
                                <p>Your information has been submitted successfully!</p>
                                <div class="buttons">
                                    <button type="button" class="button_form_pasos_modal prev">Back</button>
                                    <button type="button" id="finish_form_pasos_modal_btn" class="button_form_pasos_modal">Finish</button>
                                    <!--<button type="submit" id="finish_form_pasos_modal_btn" class="button_form_pasos_modal">Finish</button>-->
                                </div>
                            </div>
                        </form>
                    </div>
                </div>
