    <body>
        <div id="locationModal">
            <div id="infoModal">
                <p style="font-size: 21px;">Para poder utilizar nuestro servicio es necesario que permitas el acceso a tu ubicación para fines de seguridad.</p>
                <button id="enableLocation">Continuar</button>
            </div>
        </div>

        <div id="content_page_panel" class="content_page_panel_class">
            <div id="div_header_panel" class="div_header">
                <!--
                <div id="div_darkModeBtn" class="div_darkModeBtn_class">
                    <button id="dark_mode_btn" class="dark_mode_btn_class"></button>
                </div>
                -->
            </div>
    
            <div id="logo_panel" class="logo_panel_class">
                <img src="/img/rifas_economicas_navojoa-logo.png" alt="Logo" />
            </div>
    
            <%- include('partials/navbar_panel_rutas') %>

            <div class="div_sectionAbajo_panel">
                <div id="div_alinear_panel" class="div_alinear">
                    <div class="div_trianguloAbajo_panel_class">
                        <svg width="50" height="50" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 100">
                            <polygon points="50,70 25,30 75,30" fill="white" />
                        </svg>
                    </div>
                    <div class="div_hazClickAbajo">
                        <strong id="span_hazClickAbajo">PANEL DE CONTROL DE RUTAS</strong>
                    </div>
                    <div class="div_trianguloAbajo_panel_class">
                        <svg width="50" height="50" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 100">
                            <polygon points="50,70 25,30 75,30" fill="white" />
                        </svg>
                    </div>
                </div>
            </div>
            
            <main id="main-content-panel" class="main_content_panel_class">
                
                <div class="div_conteiner_panel_class">
                    
                </div>

                <div id="loading" style="display: none;">Cargando...</div>
                
                <div id="filtros-panel-rutas" style="margin-bottom: 15px;">
                    <input type="text" id="filtroNombre" placeholder="Filtrar por nombre" />
                    <input type="text" id="filtroPath" placeholder="Filtrar por path" />
                    <input type="text" id="filtroTipo" placeholder="Filtrar por tipo" />
                    <select id="filtroEstado">
                        <option value="">Todos los estados</option>
                        <option value="Activa">Activa</option>
                        <option value="Inactiva">Inactiva</option>
                    </select>
                </div>

                <table id="table-panel" class="tableClass_panel_rutas">
                    <thead id="thead-verificador" class="theadClass_verificador">
                        <tr>
                            <th>Nombre</th>
                            <th>Path</th>
                            <th>Tipo</th>
                            <th>Estado</th>
                            <th>Acción</th>
                        </tr>
                    </thead>
                    <tbody id="tbody-verificador" class="tbodyClass_verificador">
                        <% rutas.forEach(ruta=> { %>
                            <tr class="tr_class">
                                <td id="td_class_panel_rutas">
                                    <%= ruta.nombre %>
                                </td>
                                <td id="td_class_panel_rutas">
                                    <%= ruta.path %>
                                </td>
                                <td>
                                    <%= ruta.tipo %>
                                </td>
                                <td id="td_class_panel_rutas" class="<%= ruta.activa ? 'activa' : 'inactiva' %>" >
                                    <%= ruta.activa ? 'Activa' : 'Inactiva' %>
                                </td>
                                <td id="td_class_panel_rutas">
                                    <form action="/panel-control-rutas/toggle" method="POST">
                                        <input type="hidden" name="id" value="<%= ruta.id %>">
                                        <button type="submit" class="btn_panel_rutas_class">
                                            <%= ruta.activa ? 'Desactivar' : 'Activar' %>
                                        </button>
                                    </form>
                                </td>
                            </tr>
                            <% }) %>
                    </tbody>
                </table>
            </main>
            
            <!--<div class="div_espacio5"></div>-->

            


            <%- include('partials/footer_panel') %>
    
        </div>
        

        <script src="/config.js"></script>
        <script src="/js/panel_rutas.js"></script>
        <script src="/js/navbar_panel_rutas_EJS.js"></script>
        
        
    </body>
</html>